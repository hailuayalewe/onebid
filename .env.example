# Copy to .env and adjust. DEMO application — no real payments.
DATABASE_URL="mysql://root:@localhost:3306/onebid_demo"
AUTH_SECRET="replace-with-long-random-string"
# Seed admin (used only by prisma/seed.ts/seed procedure, never hardcoded in app code)
ADMIN_EMAIL="admin@demo.local"
ADMIN_PASSWORD="ChangeMe-DemoOnly!"
ADMIN_NAME="Demo Admin"
# Demo credits config
STARTING_DEMO_CREDITS=500
BID_DEMO_CREDIT_FEE=5
